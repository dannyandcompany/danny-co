# ─────────────────────────────────────────────────────────────
# Environment variables — set per environment in the Vercel dashboard
# (Project → Settings → Environment Variables: Development / Preview / Production).
#
# NOTE: one deployment serves all domains, so these are per-DEPLOYMENT defaults.
# Per-DOMAIN values (arvispro.id, tetuku.id, lelungo.com) are resolved from the
# request hostname in src/config/brands.ts — not from env.
# ─────────────────────────────────────────────────────────────

# Default brand identity (used for the apex/primary domain + previews)
NEXT_PUBLIC_APP_NAME=Danny & Company

# Canonical base URL + domain for the current environment
#   Development : http://localhost:3000        / localhost:3000
#   Preview     : https://<branch>-<proj>.vercel.app
#   Production  : https://dannyco.com           / dannyco.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DOMAIN=localhost:3000

# Kept for backward-compat with existing metadata helpers
NEXT_PUBLIC_APP_URL=http://localhost:3000
